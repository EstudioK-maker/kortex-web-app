<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data: https: http:; style-src 'self'; script-src 'self'">
  <title>Kortex</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

        </div>

<div class="app">

  <!-- Barra de separadores -->
  <header class="titlebar">
    <div class="tab-strip" id="tab-strip"></div>
    <div class="window-controls">
      <button class="window-btn" id="win-minimize" title="Minimizar"><svg viewBox="0 0 12 12"><path d="M2 6h8"/></svg></button>
      <button class="window-btn" id="win-maximize" title="Maximizar"><svg viewBox="0 0 12 12"><rect x="2.2" y="2.2" width="7.6" height="7.6" rx="1"/></svg></button>
      <button class="window-btn window-btn--close" id="win-close" title="Fechar"><svg viewBox="0 0 12 12"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7"/></svg></button>
    </div>
  </header>

  <div class="window-frame">

    <!-- Barra de ferramentas -->
    <div class="toolbar" id="toolbar">
      <div class="nav-controls">
        <button class="icon-btn" id="btn-back" title="Recuar"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></button>
        <button class="icon-btn" id="btn-forward" title="Avançar"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg></button>
        <button class="icon-btn" id="btn-reload" title="Recarregar"><svg viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.6-5.9"/><path d="M20 4v5h-5"/></svg></button>
      </div>

      <div class="url-bar" id="url-bar">
        <svg class="url-bar__lock" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
        <span class="url-bar__badge" id="url-badge" hidden></span>
        <input class="url-bar__input" id="url-input" type="text" placeholder="Pesquisa ou escreve um endereço" spellcheck="false" autocomplete="off">
        <button class="icon-btn icon-btn--sm url-star" id="btn-star" type="button" title="Adicionar aos marcadores (Ctrl+D)"><svg viewBox="0 0 24 24"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.8 6.8 19.6l1-5.8L3.5 9.7l5.9-.9L12 3.5z"/></svg></button>
      </div>

      <span class="toolbar-note" id="toolbar-note" hidden></span>

      <div class="toolbar-actions">
        <button class="icon-btn dl-btn" id="btn-downloads" type="button" title="Transferências (Ctrl+J)"><svg viewBox="0 0 24 24"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></svg><i class="dl-dot"></i></button>
        <button class="icon-btn" id="btn-private" title="Navegação Privada"><svg viewBox="0 0 24 24"><path d="M5 11a7 7 0 0 1 14 0v9l-3-2-2 2-2-2-2 2-2-2-3 2v-9z"/><circle cx="9.5" cy="11" r=".8"/><circle cx="14.5" cy="11" r=".8"/></svg></button>
        <button class="icon-btn" id="btn-extensions" title="Extensões"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><path d="M16.5 13v7M13 16.5h7"/></svg></button>
        <span class="toolbar-divider"></span>
        <button class="btn-assistant" id="btn-assistant">
          <svg viewBox="0 0 24 24"><path d="M5 5h14a1.5 1.5 0 0 1 1.5 1.5v9A1.5 1.5 0 0 1 19 17h-8l-5 4v-4H5a1.5 1.5 0 0 1-1.5-1.5v-9A1.5 1.5 0 0 1 5 5z"/></svg>
          <span>Assistente</span>
        </button>
        <button class="profile-btn" id="btn-profile">K</button>
      </div>
    </div>

    <!-- Barras opcionais (visibilidade controlada pelo atributo hidden) -->
    <div class="bookmarks-bar" id="bookmarks-bar" hidden></div>
    <div class="find-bar" id="find-bar" hidden>
      <input id="find-input" placeholder="Procurar na página" spellcheck="false" autocomplete="off">
      <span id="find-count"></span>
      <button class="icon-btn icon-btn--sm" id="find-prev" type="button" title="Anterior (Shift+Enter)">▲</button>
      <button class="icon-btn icon-btn--sm" id="find-next" type="button" title="Seguinte (Enter)">▼</button>
      <button class="icon-btn icon-btn--sm" id="find-close" type="button" title="Fechar (Esc)">✕</button>
    </div>

    <div class="workspace">

      <aside id="sidebar" class="sidebar">
        <div class="sidebar__top">
          <div class="brand-mark"><svg viewBox="0 0 32 32"><path d="M9 6v20M9 16l12-10M12.5 14l9.5 12"/></svg></div>
          <div class="sidebar__top-actions">
            <button class="icon-btn icon-btn--sm" id="btn-toggle-sidebar" title="Recolher / expandir"><svg viewBox="0 0 24 24"><rect x="3.5" y="4.5" width="17" height="15" rx="3"/><path d="M9.5 4.5v15"/></svg></button>
          </div>
        </div>

        <nav class="sidebar__nav">
          <button type="button" class="nav-item" id="nav-new-chat" data-go="about:blank"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg><span>Novo chat</span></button>
          <button type="button" class="nav-item" data-go="kortex://plugins"><svg viewBox="0 0 24 24"><path d="M9 3v4M15 3v4M7 7h10v4a5 5 0 0 1-10 0V7zM12 16v5"/></svg><span>Plugins</span></button>
          <button type="button" class="nav-item" data-go="kortex://history"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg><span>Histórico</span></button>
          <button type="button" class="nav-item" data-go="kortex://extensions"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><path d="M16.5 13v7M13 16.5h7"/></svg><span>Extensões</span></button>
        </nav>

        <div class="sidebar__scroll">
          <section class="sidebar-section" id="sidebar-recents">
            <h2 class="sidebar-section__head">Recentes</h2>
            <div id="recent-list"></div>
          </section>
        </div>

        <div class="sidebar__footer">
          <button type="button" class="user-card" id="user-card" data-go="kortex://settings">
            <span class="avatar">K</span>
            <span class="user-card__info"><span class="user-card__name">Utilizador</span></span>
          </button>
        </div>
      </aside>

      <main class="main-content">
        <div class="page-host" id="page-host">
          <section class="home-view" id="home-view">
            <svg class="home-logo" viewBox="0 0 32 32"><path d="M9 6v20M9 16l12-10M12.5 14l9.5 12"/></svg>
            <h1 class="greeting">Olá, <span id="greeting-name">Utilizador</span></h1>
            <form class="chat-input" id="home-chat-input">
              <textarea class="chat-input__field" id="home-chat-field" rows="2" placeholder="Escreve @ para conetores"></textarea>
              <div class="chat-input__bar">
                <div class="chat-input__tools">
                  <button type="button" class="icon-btn icon-btn--sm" id="home-attach" title="Anexar imagem"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></button>
                  <div class="segmented">
                    <button type="button" class="segmented__item is-active" id="home-web-search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4 4"/></svg><span>Pesquisa</span></button>
                    <button type="button" class="segmented__item" id="home-agent"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="11" rx="2"/><path d="M9 20h6M12 16v4"/></svg><span>Agente</span></button>
                  </div>
                </div>
                <div class="chat-input__actions">
                  <button type="button" class="model-select"><span>Sonnet 3.5</span></button>
                  <button type="submit" class="send-btn" id="home-send"><svg viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
                </div>
              </div>
            </form>
          </section>
        </div>

        <aside class="assistant-panel" id="assistant-panel">
          <header class="assistant-panel__header">
            <h2 class="assistant-panel__title">Assistente</h2>
            <button class="icon-btn icon-btn--sm" id="assistant-close" title="Fechar"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
          </header>
          <div class="assistant-panel__body" id="assistant-messages-box"></div>
          <form class="chat-input chat-input--compact" id="assistant-chat-input">
            <textarea class="chat-input__field" id="assistant-chat-field" rows="1" placeholder="Pergunta sobre esta página"></textarea>
            <div class="chat-input__bar">
              <div class="chat-input__actions">
                <button type="submit" class="send-btn" id="assistant-send"><svg viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
              </div>
            </div>
          </form>
        </aside>
      </main>

    </div>
  </div>
</div>

<!-- Cada script uma única vez. Ordem: app → answer → chat → features-ui → appearance -->
<script src="js/app.js"></script>
<script src="js/answer.js"></script>
<script src="js/chat.js"></script>
<script src="js/features-ui.js"></script>
<script src="js/appearance.js"></script>

    <!-- Aviso de Navegador Predefinido -->
    <div id="default-browser-banner" hidden style="position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); background: #232427; border: 1px solid #38393d; box-shadow: 0 10px 30px rgba(0,0,0,0.6); padding: 16px 24px; border-radius: 12px; display: flex; align-items: center; gap: 24px; z-index: 999999; font-family: 'Segoe UI', system-ui, sans-serif;">
      <span style="color: #e9e9eb; font-size: 14px; font-weight: 500;">Queres tornar o Kortex o teu navegador predefinido?</span>
      <div style="display: flex; gap: 8px; align-items: center;">
        <button id="btn-set-default" style="background: #ff5722; color: #fff; border: none; padding: 8px 18px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 13px; transition: 0.2s;">Sim, mudar</button>
        <button id="btn-close-banner" style="background: transparent; color: #9a9aa1; border: none; font-size: 20px; cursor: pointer; padding: 0 8px; line-height: 1;">&times;</button>
      </div>
    </div>

</body>
</html>
