'use strict';
const { app, ipcMain } = require('electron');

let ctx = { createNewTab: () => {} };
const APPS = [
  { name: 'Conta', icon: '👤', url: 'https://myaccount.google.com/', color: '#1a73e8' },
  { name: 'Drive', icon: '🔺', url: 'https://drive.google.com/', color: '#34a853' },
  { name: 'Gmail', icon: 'M', url: 'https://mail.google.com/', color: '#ea4335' },
  { name: 'YouTube', icon: '▶️', url: 'https://youtube.com/', color: '#ff0000' },
  { name: 'Maps', icon: '📍', url: 'https://maps.google.com/', color: '#4285f4' },
  { name: 'Pesquisa', icon: '🔍', url: 'https://www.google.com/', color: '#4285f4' },
  { name: 'Calendar', icon: '31', url: 'https://calendar.google.com/', color: '#1a73e8' },
  { name: 'Chrome', icon: '🌐', url: 'https://www.google.com/chrome/', color: '#fbbc04' },
  { name: 'Notícias', icon: '📰', url: 'https://news.google.com/', color: '#1a73e8' },
  { name: 'Fotos', icon: '🌸', url: 'https://photos.google.com/', color: '#ea4335' },
  { name: 'Meet', icon: '📹', url: 'https://meet.google.com/', color: '#00832d' },
  { name: 'Translate', icon: 'G', url: 'https://translate.google.com/', color: '#1a73e8' }
];

function openPopup() {
  const items = APPS.map(app => \
    <div class="app-item" data-url="\" style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 12px; border-radius: 12px; cursor: pointer; transition: background 0.2s; user-select: none;">
      <div class="app-icon" style="color: \; width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: bold;">\</div>
      <div class="app-name" style="font-size: 12px; color: #ececee; text-align: center;">\</div>
    </div>
  \).join('');

  const html = \
    <div style="padding: 24px; width: 360px; box-sizing: border-box;">
      <h2 style="margin-top: 0; color: #ececee; font-size: 18px; margin-bottom: 16px;">Aplicações Google</h2>
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px;">
        \
      </div>
      <button onclick="window.KortexModal.hide()" style="margin-top: 24px; width: 100%; background: #2c2d31; color: #ececee; border: none; padding: 12px; border-radius: 8px; cursor: pointer; font-weight: 600;">Fechar</button>
    </div>
    <script>
      document.querySelectorAll('.app-item').forEach(item => {
        item.addEventListener('mouseenter', () => item.style.background = '#2c2d31');
        item.addEventListener('mouseleave', () => item.style.background = 'transparent');
        item.addEventListener('click', () => {
          window.location.href = item.dataset.url;
          window.KortexModal.hide();
        });
      });
    </script>
  \;
  
  if (ctx.getChromeView) {
    const wc = ctx.getChromeView().webContents;
    wc.executeJavaScript(\$modalJs\).then(() => {
      wc.executeJavaScript(\window.KortexModal.show(\)\);
    });
  }
}

function init(context) {
  ctx = Object.assign({}, ctx, context);
  ipcMain.on('google-apps:open', (e, url) => ctx.createNewTab(url));
}

module.exports = { init, openPopup };
