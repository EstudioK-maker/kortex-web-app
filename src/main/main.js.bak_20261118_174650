    }
    const crxUrl = `https://clients2.google.com/service/update2/crx?response=redirect&prodversion=${googleCompat.MAJOR}.0.0.0&acceptformat=crx3&x=id%3D${extId}%26uc`;
    const response = await fetch(crxUrl, { headers: { 'User-Agent': USER_AGENT } });
    if (!response.ok) throw new Error('Falha ao descarregar da Google.');
    const buffer = Buffer.from(await response.arrayBuffer());
    const zipStart = buffer.indexOf(Buffer.from([0x50, 0x4b, 0x03, 0x04]));
    if (zipStart < 0) throw new Error('Formato de ficheiro inválido.');
    fs.mkdirSync(extDir, { recursive: true });
